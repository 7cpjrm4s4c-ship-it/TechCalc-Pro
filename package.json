    "audit:browser-compliance": "node scripts/audit-browser-compliance-phase44b5.mjs",
    "audit:toolchain": "node scripts/audit-toolchain-cleanup-phase46a.mjs",
    "audit:dom-sinks": "node scripts/audit-dom-sinks-phase46b.mjs",
